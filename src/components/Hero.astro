
---
import { Image } from "astro:assets";
import pic from "../assets/pic.webp";
---
<div class="flex items-center">
  <div>
    <p class="text-2xl mb-4">
      Hi! 👋 <br>
      <span class="text-4xl md:text-7xl font-bold">I'm <span class="text-yellow-300">David</span> Valero,</span>
    </p>
    <p class="md:text-2xl text-gray-300">
      <span class="font-bold">
      <br>full-stack developer</span> with over <span class="font-bold">4 years</span> of experiencie passionate about building high-quality applications
      with an attractive and functional design.
    </p>
  </div>
  <Image
    src={pic}
    alt="Imagen principal"
    width={220}
    height={220}
    format="webp"
    class="hidden md:flex rounded-full"
  />
</div>