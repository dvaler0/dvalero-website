---
  import links  from '../services/headerLinks.json'
  import { Image } from "astro:assets";
  import pic from "../assets/pic.webp";
  import HeaderLinks from "./HeaderLinks.astro";
---

<nav class="flex flex-row items-center justify-between md:py-7">
  <a href="/" aria-label="Ir a la página principal">
    <Image
    	src={pic}
		alt="Imagen principal"
		width={36}
		height={36}
		format="webp"
		class="rounded-full"
		loading="eager"
	/>
  </a>
  <div class="flex gap-5 flow-row">
    <div class="flex gap-5">
      {
        links.map(links =>{
          return(
            <a
              class="text-lg font-semibold text-gray-400 transition-all duration-150 hover:text-white"
              href={links.url}
              target={links.target}
            >
              {links.title}
            </a>
          )
        })
      }
    </div>
    <HeaderLinks />
  </div>
</nav>	